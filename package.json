{
  "name": "golf-ball-game",
  "version": "1.0.0",
  "description": "Golf Ball Physics Game - Babylon.js + Havok",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "postinstall": "npm run vendor:babylon",
    "vendor:babylon": "node scripts/vendor-babylon.js",
    "test": "node --test test/*.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "render:ball-faces": "node scripts/render-ball-faces.js",
    "hooks": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "babylon.js",
    "havok",
    "physics",
    "golf"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babylonjs/havok": "1.3.12",
    "babylonjs": "9.4.1",
    "babylonjs-loaders": "9.4.1",
    "babylonjs-materials": "9.4.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "puppeteer": "^25.4.0",
    "typescript": "^5.6.3"
  }
}
